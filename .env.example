# Copy to .env for local development. Never commit real values.

APP_ENV=local
APP_NAME=stormsboys-ai-agents-challenge
LOG_LEVEL=INFO

# Google / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# API
API_HOST=0.0.0.0
API_PORT=8080

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stormsboys_agents

# Demo guardrails
DEMO_MODE=true
MAX_BOOK_CHARS=200000
MAX_RETRIEVED_SECTIONS=5

